{
  "upstream_path": "references/UniAudio",
  "checkpoint_path": "data/uniaudio/checkpoints-20240722/uniaudio_v1/v1.checkpoint",
  "model_config_path": "data/uniaudio/checkpoints-20240722/uniaudio_v1/config.yaml",
  "codec_path": "data/uniaudio/checkpoints/universal_model",
  "source_path": "data/toksing/gtsinger-full.jsonl",
  "aliases_path": "rrq-svs/config/gtsinger-song-aliases.json",
  "prepared_path": "data/uniaudio/gtsinger-prepared-v1",
  "cache_path": "data/uniaudio/acoustic-cache-v1",
  "initialization": "scratch",
  "seed": 17,
  "workers": 4,
  "max_frames": 400,
  "prompt_frames": 150,
  "synthesis_chunk_frames": 400,
  "learning_rate": 0.0001,
  "lr_schedule": "warmup_inverse_sqrt",
